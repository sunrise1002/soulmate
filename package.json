{
  "name": "soulmate-workspace",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "lint": "uv run --locked ruff check .",
    "format": "uv run --locked ruff format .",
    "format:check": "uv run --locked ruff format --check .",
    "typecheck": "uv run --locked mypy",
    "test": "uv run --locked pytest",
    "build:python": "uv build --all-packages",
    "hooks:check": "uv run --locked pre-commit run --all-files",
    "lockfile:check": "uv lock --check && pnpm install --frozen-lockfile --lockfile-only",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "check:all": "pnpm lockfile:check && pnpm check && pnpm hooks:check && pnpm build:python"
  }
}
