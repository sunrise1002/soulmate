# Reference only: .env files are not loaded automatically.
# Set these variables in the process environment.
SOULMATE_CONFIG_FILE=config.toml
DATA_DIR=./data
SOULMATE_SERVER__HOST=127.0.0.1
SOULMATE_SERVER__PORT=7432
SOULMATE_PRIVACY__MODE=strict_local
SOULMATE_LLM__OLLAMA__MODEL=llama3.2
# For hybrid mode with an external OpenAI-compatible endpoint:
# SOULMATE_LLM__PROVIDER=openai_compatible
# SOULMATE_LLM__OPENAI_COMPATIBLE__BASE_URL=https://provider.example/v1
# SOULMATE_LLM__OPENAI_COMPATIBLE__MODEL=model-name
# SOULMATE_LLM__OPENAI_COMPATIBLE__API_KEY=replace-me
