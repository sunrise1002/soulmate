# Reference only: Soulmate does not load .env files automatically.
# See docs/contributor-guide/setup.md for explicit POSIX and PowerShell loading.
# Uncomment only when config.toml exists; an explicitly selected file is required.
# SOULMATE_CONFIG_FILE=./config.toml

# Root for the database, backups, generated TLS material, and other local data.
DATA_DIR=./data

# The primary daemon listener is deliberately loopback-only.
SOULMATE_SERVER__HOST=127.0.0.1
SOULMATE_SERVER__PORT=7432

# strict_local: loopback providers only; hybrid: remote HTTPS allowed;
# offline: loopback models only and no connector network access.
SOULMATE_PRIVACY__MODE=strict_local

# Optional encrypted remote backups. Local-only storage remains the default.
# Remote HTTPS endpoints require SOULMATE_PRIVACY__MODE=hybrid.
# SOULMATE_REMOTE_BACKUP__BACKEND=s3
# SOULMATE_REMOTE_BACKUP__AUTOMATIC_DAILY=true
# SOULMATE_REMOTE_BACKUP__INTERVAL_HOURS=24
# SOULMATE_REMOTE_BACKUP__PASSPHRASE=use-a-long-unique-owner-passphrase
# SOULMATE_REMOTE_BACKUP__S3__ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# SOULMATE_REMOTE_BACKUP__S3__REGION=auto
# SOULMATE_REMOTE_BACKUP__S3__BUCKET=soulmate-backups
# SOULMATE_REMOTE_BACKUP__S3__PREFIX=soulmate
# SOULMATE_REMOTE_BACKUP__S3__ACCESS_KEY_ID=replace-me
# SOULMATE_REMOTE_BACKUP__S3__SECRET_ACCESS_KEY=replace-me

# Access from other devices stays off until you enable it explicitly.
SOULMATE_NETWORK__LAN_ENABLED=false
# SOULMATE_NETWORK__LAN_HOST=192.168.1.20
# SOULMATE_NETWORK__LAN_PORT=7433

# Local Ollama. Chat is unavailable until MODEL names an installed model.
# SOULMATE_LLM__OLLAMA__BASE_URL=http://127.0.0.1:11434
# SOULMATE_LLM__OLLAMA__MODEL=llama3.2

# For hybrid mode with an external OpenAI-compatible endpoint:
# SOULMATE_LLM__PROVIDER=openai_compatible
# SOULMATE_LLM__OPENAI_COMPATIBLE__BASE_URL=https://provider.example/v1
# SOULMATE_LLM__OPENAI_COMPATIBLE__MODEL=model-name
# SOULMATE_LLM__OPENAI_COMPATIBLE__API_KEY=replace-me
