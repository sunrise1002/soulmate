{
  "name": "@soulmate/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@soulmate/sdk": "workspace:*",
    "expo": "54.0.12",
    "expo-camera": "17.0.8",
    "expo-secure-store": "15.0.7",
    "expo-status-bar": "3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "5.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/react": "19.1.10",
    "eslint": "9.39.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
